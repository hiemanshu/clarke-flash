# Clarke — environment variables (Cloudflare AI Gateway only)
# Copy to .env (gitignored) and fill in. Never commit .env.
#   cp .env.example .env
#
# Everything routes through Cloudflare AI Gateway, so this is the full list.
# The external-baseline script loads .env automatically and never overrides
# variables already exported in your shell.

# ── Required ─────────────────────────────────────────────────────────────────
# Dashboard → Workers & Pages → Account details (right sidebar).
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API token used for the REST endpoints:
#   Dashboard → My Profile → API Tokens → create token with
#   "Workers AI: Read" (and "AI Gateway: Read/Edit" if you want gateway access).
CLOUDFLARE_API_TOKEN=

# ── Gateway ──────────────────────────────────────────────────────────────────
# Gateway id (name). The literal "default" gateway is created automatically.
CLOUDFLARE_GATEWAY=default

# Only if your gateway itself enforces authentication
# (AI Gateway → Settings → Authentication). Sent as cf-aig-authorization.
# CF_AIG_TOKEN=

# ── CommandCode provider API (alternative transport) ────────────────
# Used when a spec in the models file sets "transport": "commandcode".
# Same key as the CommandCode CLI; usage draws from the plan's credits.
# Endpoints: {base}/chat/completions (OpenAI), {base}/messages (Anthropic), {base}/models.
# COMMANDCODE_API_KEY=
# COMMANDCODE_BASE_URL=https://api.commandcode.ai/provider/v1

# ── Provider keys — only needed if you do NOT store keys in the gateway ──────
# Recommended: store them once in AI Gateway → Providers (BYOK), then leave these empty.
# If set, they are forwarded as Authorization headers.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ── Models (which models get called) ─────────────────────────────────────────
# Declared in configs/external_models.json, not here. That file lists
# {label, kind: chat|clairic, model}. Edit it to add/remove models; no code change.
#
# Run everything with:
#   uv run python scripts/external_baseline.py --models-file configs/external_models.json \
#       --data data/real_eval.jsonl --limit 20 --out-dir reports/external
