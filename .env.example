# Clarke — environment variables
# Copy to .env (gitignored) and fill in. Never commit .env.
#   cp .env.example .env
#
# The external-baseline script loads .env automatically if present, and any
# variable already exported in your shell takes precedence.
#
#   uv run python scripts/external_baseline.py --provider cloudflare \
#       --model @cf/cloudflare/clairic --limit 20 --out reports/external-clairic.json

# ── Cloudflare (required for Clairic and for AI Gateway routing) ──────────────
# Account ID: dashboard → Workers & Pages → Account details (right sidebar).
CLOUDFLARE_ACCOUNT_ID=

# AI Gateway token: dashboard → AI Gateway → your gateway → Settings → API token.
# Used as: cf-aig-authorization: Bearer <token>
CF_AIG_TOKEN=

# Workers AI API token: dashboard → My Profile → API Tokens → "Workers AI" template.
# Needed only when calling Clairic DIRECTLY (not through the gateway).
CLOUDFLARE_API_TOKEN=

# Gateway name to route chat models through (also passed as --gateway).
# The literal "default" gateway exists automatically.
CLOUDFLARE_GATEWAY=default

# ── Frontier chat models (only needed for direct calls, not with gateway BYOK) ─
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: point at a compatible proxy/gateway instead of the vendor API.
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ── Optional conveniences ────────────────────────────────────────────────────
# Hugging Face token, only if you start hitting anonymous rate limits on downloads.
# HF_TOKEN=

# Default models used in examples (informational; pass --model explicitly anyway).
# CLAIRIC_MODEL=@cf/cloudflare/clairic
# OPENAI_MODEL=gpt-6-luna
# ANTHROPIC_MODEL=claude-opus-5-5
