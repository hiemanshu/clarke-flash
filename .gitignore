# --- python environments / builds ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
build/
dist/

# --- training artifacts: heavy, regenerable, published to the Hub (not git) ---
runs/
data/
*.safetensors
*.pt
wandb/

# --- local state / secrets ---
.env
*.key
keys.json

# --- editors / OS noise ---
.idea/
.vscode/
*.swp
.DS_Store

# --- generated artifacts (kept on disk, not in git) ---
# reports/ holds regenerable eval JSONs; only the external-baseline README is tracked
# (git cannot re-include a file whose parent dir is excluded, hence the two-step pattern).
reports/*
!reports/external/
reports/external/*
!reports/external/README.md

# --- transient logs ---
logs/
